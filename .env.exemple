# Développement local : copier en .env et adapter. Sur le serveur, la plateforme injecte
# DB_* et EVENTS_URL ; SESSION_SECRET est déposé par l'administrateur.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmat
DB_USER=pharmat
DB_PASSWORD=
URL_PUBLIQUE=http://localhost:3000
# SESSION_SECRET=une-longue-valeur-aleatoire       # obligatoire en production
