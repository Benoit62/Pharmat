<%- include('partiels/haut') %>
<div class="pm-tres-etroit">
  <div class="pm-tete"><h1>Inscription</h1><p>Un compte gratuit pour suivre ta progression.</p></div>
  <% if (typeof erreur !== 'undefined') { %>
    <div class="bw-message bw-message--erreur pm-flash" role="alert"><%- icone('circle-x') %><p><%= erreur %></p></div>
  <% } %>
  <form class="bw-formulaire" method="post" action="/inscription">
    <div class="bw-champ">
      <label class="bw-libelle" for="nom">Prénom</label>
      <input class="bw-saisie" id="nom" name="nom" autocomplete="given-name" required minlength="2" maxlength="30" value="<%= valeurs.nom || '' %>">
    </div>
    <div class="bw-champ">
      <label class="bw-libelle" for="mail">Adresse électronique</label>
      <input class="bw-saisie" id="mail" name="mail" type="email" autocomplete="email" required maxlength="190" value="<%= valeurs.mail || '' %>">
      <% if (courrielActif) { %><span class="bw-aide">Un lien de confirmation y sera envoyé.</span><% } %>
    </div>
    <div class="bw-champ">
      <label class="bw-libelle" for="mot_de_passe">Mot de passe</label>
      <input class="bw-saisie" id="mot_de_passe" name="mot_de_passe" type="password" autocomplete="new-password" required minlength="8">
      <span class="bw-aide">8 caractères au moins.</span>
    </div>
    <div class="bw-champ">
      <label class="bw-libelle" for="confirmation">Confirmation</label>
      <input class="bw-saisie" id="confirmation" name="confirmation" type="password" autocomplete="new-password" required minlength="8">
    </div>
    <button class="bw-btn bw-btn--principal bw-btn--plein" type="submit">Créer mon compte</button>
  </form>
  <p class="bw-petit" style="margin-top:24px;text-align:center">Déjà un compte ? <a href="/connexion">Connexion</a></p>
</div>
<%- include('partiels/bas') %>
