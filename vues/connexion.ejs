<%- include('partiels/haut') %>
<div class="pm-tres-etroit">
  <div class="pm-tete"><h1>Connexion</h1><p>Content de te revoir.</p></div>
  <% if (typeof erreur !== 'undefined') { %>
    <div class="bw-message bw-message--erreur pm-flash" role="alert"><%- icone('circle-x') %><p><%= erreur %></p></div>
  <% } %>
  <% if (typeof nonConfirme !== 'undefined') { %>
    <div class="bw-message bw-message--attention pm-flash" role="alert"><%- icone('mail') %>
      <div><p><strong>Adresse pas encore confirmée.</strong> Clique sur le lien reçu par courriel.</p>
        <form method="post" action="/confirmation/renvoyer"><input type="hidden" name="mail" value="<%= mail %>"><button class="bw-btn bw-btn--discret" type="submit">Renvoyer le lien</button></form>
      </div>
    </div>
  <% } %>
  <form class="bw-formulaire" method="post" action="/connexion">
    <input type="hidden" name="retour" value="<%= retour %>">
    <div class="bw-champ">
      <label class="bw-libelle" for="mail">Adresse électronique</label>
      <input class="bw-saisie" id="mail" name="mail" type="email" autocomplete="email" required value="<%= mail %>" autofocus>
    </div>
    <div class="bw-champ">
      <label class="bw-libelle" for="mot_de_passe">Mot de passe</label>
      <input class="bw-saisie" id="mot_de_passe" name="mot_de_passe" type="password" autocomplete="current-password" required>
      <% if (courrielActif) { %><a class="bw-aide" href="/mot-de-passe-oublie">Mot de passe oublié ?</a><% } %>
    </div>
    <button class="bw-btn bw-btn--principal bw-btn--plein" type="submit"><%- icone('log-in') %>Se connecter</button>
  </form>
  <p class="bw-petit" style="margin-top:24px;text-align:center">Pas encore de compte ? <a href="/inscription">Inscription</a></p>
</div>
<%- include('partiels/bas') %>
